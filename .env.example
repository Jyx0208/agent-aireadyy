# Web users enter their own API key on the page.
# CLI users must fill in AGENT_LLM_API_KEY below before running.
AGENT_LLM_API_KEY=your_deepseek_api_key
AGENT_LLM_BASE_URL=https://api.deepseek.com
AGENT_LLM_MODEL=deepseek-v4-flash
AGENT_LLM_TIMEOUT=1200
AGENT_MAX_CONCURRENT_TASKS=2
AGENT_RESULT_RETENTION_SECONDS=1800
AGENT_MAX_RESULT_PROJECTS=4
AGENT_PRIDE_CACHE_DIR=/app/.agent_cache/pride
AGENT_IPROX_HOST_XLSX=./iProx数据(1).xlsx
AGENT_IPROX_INDEX_XLSX=/app/data/iprox.xlsx
AGENT_ZIP_COMPRESS_LEVEL=6
AGENT_CONTAINER_RUNS_DIR=/app/runs
AGENT_HOST_RUNS_DIR=/opt/pride-agent/runs

# On Linux set this with:
# DOCKER_GID=$(stat -c '%g' /var/run/docker.sock)
DOCKER_GID=0
