# Copy this file to .env before using docker compose.
# Do not commit real API keys.

TZ=Asia/Shanghai

# LLM settings. Web users can also enter a key on the page.
AGENT_LLM_API_KEY=your_deepseek_api_key
DEEPSEEK_API_KEY=your_deepseek_api_key
AGENT_LLM_BASE_URL=https://api.deepseek.com
AGENT_LLM_MODEL=deepseek-v4-pro
AGENT_LLM_TIMEOUT=1200
AGENT_LLM_CONFIG_PATH=.agent_secrets/llm_config.json
# OpenAI Agents SDK traces are disabled by default. Enable only after reviewing
# whether model/tool inputs may be exported to the configured trace processor.
AGENT_OPENAI_AGENTS_TRACING=0

# OpenAI Agents Discovery rollout. Multi-agent mode is opt-in; these values are
# server-enforced hard ceilings while the Budget Agent allocates work dynamically.
AGENT_DISCOVERY_MODE=single_agent
AGENT_MAX_MODEL_TURNS=50
AGENT_MAX_TOOL_CALLS=100
AGENT_MAX_QUERY_UNITS=30
AGENT_MAX_REPOSITORY_REQUESTS=200
AGENT_MAX_ELAPSED_SECONDS=1200
AGENT_BUDGET_AGENT_MAX_TURNS=3

# Web/runtime safety defaults.
AGENT_MAX_CONCURRENT_TASKS=2
AGENT_SEARCH_THREADS=10
AGENT_FRAGPIPE_RAM_GB=0
AGENT_RESULT_RETENTION_SECONDS=1800
AGENT_MAX_RESULT_PROJECTS=4
AGENT_PROTECTED_RESULT_DIRS=baseline_validation,real_smoke,multi_mini_validation,local_validation,ai_ready_builds
AGENT_WEB_FULL_WORKFLOW_ENABLED=0
AGENT_ZIP_COMPRESS_LEVEL=6

# Paths inside the agent container.
AGENT_PRIDE_CACHE_DIR=/app/.agent_cache/pride
AGENT_IPROX_INDEX_XLSX=/app/data/iprox.xlsx
AGENT_CONTAINER_APP_DIR=/app
AGENT_CONTAINER_RUNS_DIR=/app/runs

# Optional advanced mode for Linux/named-volume deployments. Leave empty unless
# you have verified nested Docker can read the inherited /app mount.
AGENT_DOCKER_VOLUMES_FROM=

# Fallback host paths visible to the Docker daemon. Keep these accurate if
# AGENT_DOCKER_VOLUMES_FROM is disabled or if you run the CLI outside Compose.
# Linux server example:
AGENT_HOST_APP_DIR=/opt/pride-agent
AGENT_HOST_RUNS_DIR=/opt/pride-agent/runs

# Full workflow watchdogs. These keep low-PSM or silent nested Docker jobs from
# occupying the Web queue indefinitely.
AGENT_MSDT_DOCKER_TIMEOUT_SECONDS=7200
AGENT_MSDT_DOCKER_IDLE_TIMEOUT_SECONDS=900
AGENT_MSDT_ABORT_ON_LOW_PSM=1

# Docker Desktop / Windows fallback is environment-specific. The Web,
# Discovery, AI-ready exporters, tests, and prepare mode work in this Compose
# image; fully automated nested-Docker full mode on Windows needs a validated
# host-helper or Docker-in-Docker setup before being advertised as supported.
